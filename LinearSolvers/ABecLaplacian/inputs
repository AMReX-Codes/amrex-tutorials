# Boundary condition in each direction: dirichlet, neumann or periodic
bc = dirichlet neumann periodic

# a*alpha*phi - b*div(beta*grad(phi)) = rhs, beta = beta_in inside a sphere
a = 1.0
b = 1.0
beta_in = 10.0

# MLMG settings
mlmg.verbose = 1
mlmg.max_iter = 100
mlmg.linop_maxorder = 2
